generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Match {
  id       String   @id // Le game_id de l'API
  queueId  String
  result   String // "win" ou "loss"
  mmrAfter Int
  playedAt DateTime

  @@index([queueId])
}
